# Salin file ini menjadi .env lalu isi nilainya:
#   cp .env.example .env
#
# .env TIDAK di-commit ke git (sudah diblokir .gitignore).

# Password root MySQL — WAJIB diisi, pakai yang panjang & acak.
# Contoh membuat password acak: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=

# Lokasi penyimpanan data di host (biarkan default ini saja).
DATA_ROOT=/srv/data
